# Copy to .env (same folder) and fill in. Never commit .env.

# Your domain, without https:// — e.g. almostafa.com (point its DNS A record to this server first).
DOMAIN=

# The administrator account for /admin/login.
ADMIN_EMAIL=
# At least 8 characters. Needed for the first start; you may remove it afterwards.
ADMIN_PASSWORD=

# Database password. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=
