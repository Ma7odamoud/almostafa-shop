{
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "CookieName": "almostafa_session"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "LoginPerMinute": 5,
    "OrdersPerMinute": 10
  },
  "Media": {
    "MaxUploadBytes": 8388608
  },
  "Storage": {
    "UploadsPath": "data/uploads",
    "PublicPath": "/uploads"
  },
  "LegacyImport": {
    "DataPath": "",
    "UploadsPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
